<routes>

    <vType
        id="car"
        accel="2.6"
        decel="4.5"
        sigma="0.5"
        length="5.0"
        minGap="2.5"
        maxSpeed="27.78"
        speedFactor="1.0"
        speedDev="0.1"
        guiShape="passenger"/>

    <!-- ==========================================
         EASTBOUND: Zone 0 → Zone 4
         ========================================== -->
    <route
        id="route_eastbound"
        edges="e0_east e1_east e2_east e3_east e4_east"/>

    <!-- ==========================================
         WESTBOUND: Zone 4 → Zone 0
         ========================================== -->
    <route
        id="route_westbound"
        edges="e4_west e3_west e2_west e1_west e0_west"/>

    <!-- ==========================================
         Eastbound traffic
         ========================================== -->
    <flow
        id="eastbound_flow"
        type="car"
        route="route_eastbound"
        begin="0"
        end="600"
        vehsPerHour="900"
        departLane="best"
        departSpeed="max"/>

    <!-- ==========================================
         Westbound traffic
         ========================================== -->
    <flow
        id="westbound_flow"
        type="car"
        route="route_westbound"
        begin="0"
        end="600"
        vehsPerHour="900"
        departLane="best"
        departSpeed="max"/>

</routes>
